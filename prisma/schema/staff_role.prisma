// Dashboard access profile for staff accounts (e.g. Manager, Staff).
// `permissions` holds keys from module/staff/staffPermissions.ts.
model StaffRole {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[] @default([])
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("staff_roles")
}
