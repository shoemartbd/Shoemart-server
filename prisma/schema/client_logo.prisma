// Logos of companies we work for, shown on the homepage before testimonials
model ClientLogo {
  id        String   @id @default(uuid())
  name      String
  logo      String
  website   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_logos")
}
